From 970222d6ae0073e38289a691245a0f13392b8641 Mon Sep 17 00:00:00 2001
From: "chak-kei.lam" <chak-kei.lam@mediatek.com>
Date: Tue, 3 Feb 2026 10:59:49 +0800
Subject: [PATCH] net: ethernet: mtk_eth_soc: fix mtk_eth_offload_init memory
Upstream-Status: Pending
---
diff -Naur kernel-source.orign/drivers/net/ethernet/mediatek/mtk_eth_soc.h kernel-source/drivers/net/ethernet/mediatek/mtk_eth_soc.h
--- kernel-source.orign/drivers/net/ethernet/mediatek/mtk_eth_soc.h	2026-07-01 12:20:42.224220043 +0000
+++ kernel-source/drivers/net/ethernet/mediatek/mtk_eth_soc.h	2026-07-01 12:14:54.996857035 +0000
@@ -1979,7 +1979,7 @@
 int mtk_ptp_clock_init(struct mtk_eth *eth);
 int mtk_ptp_clock_deinit(struct mtk_eth *eth);
 
-int mtk_eth_offload_init(struct mtk_eth *eth, u8 id);
+int mtk_eth_offload_init(struct mtk_eth *eth);
 int mtk_eth_setup_tc(struct net_device *dev, enum tc_setup_type type,
 		     void *type_data);
 int mtk_flow_offload_cmd(struct mtk_eth *eth, struct flow_cls_offload *cls,
diff -Naur kernel-source.orign/drivers/net/ethernet/mediatek/mtk_eth_soc.c kernel-source/drivers/net/ethernet/mediatek/mtk_eth_soc.c
--- kernel-source.orign/drivers/net/ethernet/mediatek/mtk_eth_soc.c	2026-07-01 12:56:02.132918815 +0000
+++ kernel-source/drivers/net/ethernet/mediatek/mtk_eth_soc.c	2026-07-01 12:58:04.826118360 +0000
@@ -7121,12 +7121,12 @@
 				err = -ENOMEM;
 				goto err_deinit_ppe;
 			}
-			err = mtk_eth_offload_init(eth, i);
-
-			if (err)
-				goto err_deinit_ppe;
 		}
 
+                err = mtk_eth_offload_init(eth);
+                if (err)
+                        goto err_deinit_ppe;
+
 		err = mtk_ppe_internal_debugfs_init(eth);
 		if (err)
 			goto err_deinit_ppe;
